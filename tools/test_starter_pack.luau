local fs = require("@lune/fs")
local luau = require("@lune/luau")

local products = luau.load(fs.readFile("src/server/services/MarketPlaceHandler/ProductConfig.luau"))()
local pack = products.Rewards[3714990977]
assert(pack, "Starter Pack developer product is not registered")
assert(#pack.rewards.buildings == 3, "Starter Pack must grant exactly three buildings")
assert(pack.rewards.buildings[1] == "PetronasTowers")
assert(pack.rewards.buildings[2] == "SkyscraperGeneric")
assert(pack.rewards.buildings[3] == "MilitaryBase")

local lifecycle = fs.readFile("src/client/controllers/ui/UIController/Lifecycle.luau")
local buttons = fs.readFile("src/client/controllers/ui/UIController/Buttons.luau")
local source = fs.readFile("src/client/controllers/ui/UIController/StarterPack.luau")
assert(lifecycle:find('FindFirstChild%("Starterpack"%)'), "Frames.Starterpack is not discovered")
assert(lifecycle:find('BuilderPackFrame = State.FramesFolder:FindFirstChild%("BuilderPack"%)'), "Frames.BuilderPack is not separate")
assert(buttons:find("UIController.toggleUIFrame%(State.BuilderPackFrame%)"), "BuilderPack button does not open BuilderPack")
assert(buttons:find("State.BuilderPackFrame.Frame.X", 1, true), "BuilderPack close binding is missing")
assert(source:find("PRODUCT_ID = 3714990977", 1, true), "purchase prompt uses the wrong product")
for _, name in { "Airport", "ApexTower", "MilitaryBase" } do
	assert(source:find('card = "' .. name .. '"', 1, true), "missing reward card " .. name)
end
assert(source:find('building = "SkyscraperGeneric"', 1, true), "Apex Tower preview does not use its internal key")
assert(source:find('card = "Airport", building = "PetronasTowers", label = "Petronas Towers"', 1, true), "Airport card was not remapped to Petronas Towers")
assert(source:find('FindFirstChild%("sunburst"%)'), "sunbursts are not animated")
assert(source:find('FindFirstChild%("stars", true%)'), "authored stars are not animated")
assert(source:find("starsFolder:GetDescendants%(%)"), "nested background stars are not collected")
assert(source:find("star.Active = false", 1, true), "background stars still intercept input")
assert(source:find("PromptProductPurchase", 1, true), "purchase button is not connected")
assert(source:find("GetProductInfoAsync", 1, true), "client-local product price is not loaded")
assert(source:find('FindFirstChild%("Frame"%)') and source:find('FindFirstChild%("TextLabel"%)'), "exact purchase price label is not targeted")
assert(source:find('local text = "\\u{E002}" %.%. tostring%(price%)'), "price text is not the Robux glyph plus local price")
assert(source:find("displayPrice%(info.PriceInRobux%)"), "Starter Pack purchase price is not localized")
assert(buttons:find("BUILDER_PACK_PRODUCT_ID = 3388944230", 1, true), "BuilderPack HUD price uses the wrong offer")
assert(
	buttons:find("fetchPrice%(text, BUILDER_PACK_PRODUCT_ID, Enum.InfoType.Product%)"),
	"BuilderPack HUD price is not localized from its developer product"
)
assert(buttons:find("SKYLINE_PRODUCT_ID = 3714990977", 1, true), "Skyline button uses the wrong product")
assert(not buttons:find('right:FindFirstChild%("SkylinePack"%)'), "Skyline was incorrectly created as another side button")
assert(buttons:find("State.skylinePackIcon = Icon", 1, true), "Skyline TopbarPlus icon is not created")
assert(buttons:find(':setImage%("rbxassetid://98703767607590"%)'), "Skyline topbar uses the wrong icon")
assert(buttons:find(':align%("Left"%)'), "Skyline is not beside the existing left-side topbar icons")
assert(not buttons:find('skylinePackIcon:setLabel', 1, true), "Skyline topbar is not a single icon")
assert(buttons:find('setCaption%("Skyline Pack · \\u{E002}" %.%. tostring%(info.PriceInRobux%)%)'), "localized Skyline price is not in the caption")
assert(buttons:find("GetProductInfoAsync%(SKYLINE_PRODUCT_ID, Enum.InfoType.Product%)"), "Skyline price is not localized")
assert(buttons:find("UIController.openUIFrame%(State.StarterPackFrame%)"), "Skyline topbar does not open Starterpack")
assert(source:find("FIRST_REMINDER_SECONDS = 4 %* 60"), "first reminder is not four minutes")
assert(source:find("SECOND_REMINDER_SECONDS = 30 %* 60"), "second reminder is not thirty minutes later")
assert(source:find("PromptProductPurchaseFinished", 1, true), "successful purchase does not suppress the second reminder")
assert(source:find("Context.UIController.closeUIFrame%(root%)"), "successful purchase does not close Starter Pack")
assert(source:find("State.skylinePackIcon:deselect%(%)"), "successful purchase does not deselect Skyline topbar icon")
assert(source:find("StarterPackCamera", 1, true) and source:find("StarterPackPreview", 1, true), "3D previews are missing")
assert(source:find("random:NextNumber%(8, 15%)") and source:find("random:NextNumber%(4%.5, 7%)"), "GTS timing was changed")
assert(source:find("transform%(buttonPose, 1, rotation%)"), "purchase button shake is missing")
assert(source:find("buttonGradient.Offset", 1, true), "purchase button gradient shine is missing")
assert(not source:find("purchase.MouseEnter", 1, true) and not source:find("purchase.InputBegan", 1, true), "purchase button hover/press effects remain")
assert(not source:find("stroke.Thickness", 1, true) and not source:find("targetScale", 1, true), "purchase button stroke/scale effects remain")
assert(source:find("PREVIEW_YAW_OFFSET = math.rad%(180%)"), "preview facing correction is not 180 degrees")
assert(source:find("PREVIEW_SPIN_SPEED = math.rad%(18%)"), "reward buildings do not spin")
assert(source:find("PREVIEW_CAMERA_TILT = 0%.28"), "reward camera is not tilted toward the models")
assert(source:find('buildingName == "MilitaryBase"'), "Military Base preview flight is missing")
assert(source:find('FindFirstChild%("Heli", true%)'), "Military Base preview does not use its helicopter")
assert(source:find('FindFirstChild%("MainBlades", true%)') and source:find('FindFirstChild%("RearRotor", true%)'), "preview helicopter rotors are missing")
assert(not source:find('buildingName == "Airport"'), "obsolete Airport preview flight remains")
assert(source:find("rotorSpin = t %* math.rad%(900%)"), "preview helicopter blades do not spin")
assert(source:find("if preview.Flight then distance %*= 1%.22 end"), "flight previews are not framed with extra clearance")
print("PASS: Starter Pack hierarchy, GTS motion, live price, previews and receipt reward mapping")
