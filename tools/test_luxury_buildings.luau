local fs, luau = require("@lune/fs"), require("@lune/luau")
local luxury = luau.load(fs.readFile("src/server/config/BuildingConfig/Luxury.luau"))()
local first, last = luxury.LuxurySkyscraper, luxury.BurjKhalifa
assert(first and last and first.DisplayName == "Luxury Skyscraper" and last.DisplayName == "Burj Khalifa")
assert(first.Rarity == "Luxury" and last.Rarity == "Luxury")
assert(last.Cost > first.Cost and last.Income > first.Income and last.BuildTime > first.BuildTime)
assert(last.Population > first.Population and last.BuildLimit == 1)
assert(last.Size == "6x6" and first.Size == "5x5")
local shop = fs.readFile("src/client/controllers/shop/ShopController/StockDisplay.luau")
assert(shop:find("LuxurySkyscraper = 1, BurjKhalifa = 2", 1, true), "Luxury order not fixed at catalogue end")
local runtime = fs.readFile("src/server/bootstrap/WorldRuntime.luau")
assert(runtime:find('LuxurySkyscraper = "Luxury Skyscraper"', 1, true))
assert(runtime:find('BurjKhalifa = "Burj Khalifa"', 1, true))
print("PASS: Luxury skyscrapers have stable model keys, ordered catalogue entries and top-end progression")
